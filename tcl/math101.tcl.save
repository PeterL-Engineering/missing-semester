set X 100
set Y 256
set Z [expr {$Y + $X}]
set Z_LABEL "$Y plus $X is "

puts "$Z_LABEL $Z"

puts "Because of the precedence rules \"5 + -3 * 4 \" is: [expr {-3 * 4 + 5}]"
puts "Because of the parentheses \"(5 + -3) * 4 \" is: [expr {(5 + -3} * 4]"

set A 3
set B 4
puts "The hypotenuse of a triangle: [expr {hypot($A, %B)}]"

